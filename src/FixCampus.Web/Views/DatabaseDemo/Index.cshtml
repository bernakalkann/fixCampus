@{
    ViewData["Title"] = "Veritabanı Örnek İlan";
}
<section class="container py-5" aria-labelledby="demo-title">
    <h1 id="demo-title">Veritabanından örnek ilan</h1>
    <p>Ortak Supabase veritabanına kaydedilmiş ilanı görüntüle.</p>
    <button id="reload" class="btn btn-primary" type="button">İlanı yenile</button>
    <p id="status" class="mt-3" role="status" aria-live="polite"></p>
    <article id="listing" class="border rounded p-4 mt-3" hidden>
        <span class="badge bg-success align-self-start">Supabase · Kalıcı kayıt</span>
        <h2 id="title" class="mt-3"></h2>
        <p id="description"></p>
        <dl>
            <dt>Yer</dt><dd id="location"></dd>
            <dt>Kategori</dt><dd id="category"></dd>
            <dt>Tür / Durum</dt><dd id="state"></dd>
            <dt>Kayıt kimliği</dt><dd id="identity"></dd>
        </dl>
    </article>
</section>
<script>
(() => {
    const button = document.getElementById('reload');
    const status = document.getElementById('status');
    const card = document.getElementById('listing');
    async function load() {
        button.disabled = true;
        card.hidden = true;
        status.textContent = 'İlan yükleniyor…';
        try {
            const response = await fetch('/api/veritabani/ornek-ilan', { cache: 'no-store' });
            const data = await response.json();
            if (!response.ok) throw new Error(data.title || 'İlan yüklenemedi.');
            for (const [id, value] of Object.entries({
                title: data.baslik, description: data.aciklama, location: data.yer,
                category: data.kategori, state: data.tur + ' / ' + data.durum, identity: data.id
            })) document.getElementById(id).textContent = value;
            card.hidden = false;
            status.textContent = 'İlan veritabanından okundu.';
        } catch (error) {
            status.textContent = error.message || 'Sunucuya bağlanılamadı.';
        } finally {
            button.disabled = false;
        }
    }
    button.addEventListener('click', load);
    load();
})();
</script>
