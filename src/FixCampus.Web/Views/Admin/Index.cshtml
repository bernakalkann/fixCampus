@{
    ViewData["Title"] = "Yönetici Paneli (Admin)";
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <!-- Yönetici Başlık Kartı -->
    <div class="card border rounded-4 shadow-sm bg-white overflow-hidden mb-4">
        <div class="p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-circle bg-danger text-white fs-3 shadow-sm" style="width: 64px; height: 64px;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h3 class="fw-bold text-dark mb-0">fixCampus Yönetici Paneli</h3>
                            <span class="badge bg-danger rounded-pill px-3 py-1">Yönetici Yetkisi</span>
                        </div>
                        <p class="text-muted small mb-0">
                            İlan moderasyonu, uygunsuz içerik denetimi ve kategori yönetim konsolu.
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-3 px-3">
                        <i class="bi bi-house me-1"></i> Kullanıcı Arayüzüne Dön
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-light border text-danger btn-sm rounded-3 px-3">
                            <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- İstatistik Şeridi -->
        <div class="border-top bg-light p-3 p-md-4">
            <div class="row g-3 text-center">
                <div class="col-6 col-md-3">
                    <div class="p-2">
                        <span class="text-muted small d-block mb-1">Toplam İlan Sayısı</span>
                        <strong class="fs-4 text-dark">48</strong>
                    </div>
                </div>
                <div class="col-6 col-md-3 border-start">
                    <div class="p-2">
                        <span class="text-muted small d-block mb-1">Aktif Sosyal Radar</span>
                        <strong class="fs-4 text-dark">19</strong>
                    </div>
                </div>
                <div class="col-6 col-md-3 border-start">
                    <div class="p-2">
                        <span class="text-muted small d-block mb-1">Kayıp & Buluntu</span>
                        <strong class="fs-4 text-dark">26</strong>
                    </div>
                </div>
                <div class="col-6 col-md-3 border-start">
                    <div class="p-2">
                        <span class="text-muted small d-block mb-1 text-danger fw-semibold">Bildirilen / Uygunsuz</span>
                        <strong class="fs-4 text-danger">3</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sol Kolon: Bildirilen İlanları İnceleme Tablosu -->
        <div class="col-lg-8">
            <div class="card border rounded-4 shadow-sm bg-white overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-flag-fill text-danger me-2"></i> İncelenmesi Gereken Bildirilen İlanlar
                        </h5>
                        <small class="text-muted">Öğrencilerin şikayet ettiği veya kurallara aykırı bulunan ilanlar</small>
                    </div>
                    <span class="badge bg-danger-subtle text-danger border px-2 py-1">3 Bekleyen Bildirim</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>İlan Bilgisi</th>
                                <th>Tür</th>
                                <th>Bildirim Nedeni</th>
                                <th>Tarih</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            <!-- Bildirim 1 -->
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">[Kayıp] Satılık İphone Telefon</strong>
                                    <span class="text-muted" style="font-size: 0.75rem;">Yayınlayan: Öğrenci (22290888)</span>
                                </td>
                                <td><span class="badge bg-light text-dark border">Kayıp Eşya</span></td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border">Ticari / Satış Amacı</span>
                                    <div class="text-muted mt-1" style="font-size: 0.72rem;">Kayıp ilanı yerine satış yapılmaya çalışılıyor.</div>
                                </td>
                                <td class="text-muted">Bugün 11:20</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <form asp-action="HideListing" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="listingId" value="101" />
                                            <button type="submit" class="btn btn-sm btn-danger py-1 px-2" title="İlanı Yayından Kaldır">
                                                <i class="bi bi-eye-slash me-1"></i> Gizle
                                            </button>
                                        </form>
                                        <form asp-action="ApproveListing" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="listingId" value="101" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Bildirimi Reddet (İlanı Koru)">
                                                Onayla
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- Bildirim 2 -->
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">[Radar] Sahte Etkinlik Başlığı</strong>
                                    <span class="text-muted" style="font-size: 0.75rem;">Yayınlayan: Öğrenci (22290777)</span>
                                </td>
                                <td><span class="badge bg-light text-dark border">Sosyal Radar</span></td>
                                <td>
                                    <span class="badge bg-warning-subtle text-dark border">Spam / Alakasız</span>
                                    <div class="text-muted mt-1" style="font-size: 0.72rem;">İçerikte hiçbir buluşma yeri belirtilmemiş.</div>
                                </td>
                                <td class="text-muted">Dün 18:45</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <form asp-action="HideListing" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="listingId" value="102" />
                                            <button type="submit" class="btn btn-sm btn-danger py-1 px-2">
                                                <i class="bi bi-eye-slash me-1"></i> Gizle
                                            </button>
                                        </form>
                                        <form asp-action="ApproveListing" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="listingId" value="102" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                                Onayla
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- Bildirim 3 -->
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">[Buluntu] Özel Kimlik Bilgisi Paylaşımı</strong>
                                    <span class="text-muted" style="font-size: 0.75rem;">Yayınlayan: Öğrenci (22290666)</span>
                                </td>
                                <td><span class="badge bg-light text-dark border">Buluntu Eşya</span></td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border">Gizlilik İhlali</span>
                                    <div class="text-muted mt-1" style="font-size: 0.72rem;">Kimlik üzerindeki T.C. no açıkça fotoğraflanmış.</div>
                                </td>
                                <td class="text-muted">23 Ekim 2026</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <form asp-action="HideListing" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="listingId" value="103" />
                                            <button type="submit" class="btn btn-sm btn-danger py-1 px-2">
                                                <i class="bi bi-eye-slash me-1"></i> Gizle
                                            </button>
                                        </form>
                                        <form asp-action="ApproveListing" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="listingId" value="103" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                                Onayla
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Kategori Yönetimi ve Sistem Durumu -->
        <div class="col-lg-4">
            
            <!-- Kategori Ekleme Kartı -->
            <div class="card border rounded-4 shadow-sm bg-white mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-tags-fill text-dark me-2"></i> Kategori Yönetimi
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddCategory" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <label class="form-label small fw-semibold text-dark">Yeni İlan Kategorisi Ekle</label>
                        <div class="input-group">
                            <input type="text" name="categoryName" class="form-control form-control-sm" placeholder="Örn: Kulüp Etkinliği" required />
                            <button type="submit" class="btn btn-sm btn-dark">Ekle</button>
                        </div>
                    </form>

                    <span class="small text-muted d-block mb-2 fw-semibold">Mevcut Aktif Kategoriler:</span>
                    <ul class="list-group list-group-flush border rounded-3 small">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span>Sosyal Buluşma</span>
                            <span class="badge bg-light text-dark border">14 İlan</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span>Kütüphane & Çalışma Grubu</span>
                            <span class="badge bg-light text-dark border">9 İlan</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span>Kayıp Eşya</span>
                            <span class="badge bg-light text-dark border">15 İlan</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span>Buluntu Eşya</span>
                            <span class="badge bg-light text-dark border">11 İlan</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span>Spor & Açık Hava</span>
                            <span class="badge bg-light text-dark border">5 İlan</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Güvenlik & Denetim Kartı -->
            <div class="card border rounded-4 shadow-sm bg-white p-4">
                <h6 class="fw-bold text-dark mb-2">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i> Yetki & Moderasyon Notu
                </h6>
                <p class="text-muted small mb-2">
                    Bu panele yalnızca <strong>Yönetici (Admin)</strong> rolüne sahip yetkili hesaplar erişebilir.
                </p>
                <div class="bg-light p-2 rounded-3 small text-secondary">
                    <div>&bull; Rol Politikası: <code>[Authorize(Roles = "Yonetici")]</code></div>
                    <div>&bull; Giriş Modu: Yönetici Segmenti</div>
                </div>
            </div>

        </div>
    </div>

</div>
