@model FixCampus.Web.Models.ListingListViewModel

<div class="container py-4">
    <!-- Sayfa Başlığı ve Yeni İlan Butonu -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">@ViewData["Title"]</h2>
            <p class="text-muted small mb-0">Kampüsteki sosyal buluşmalar, kayıp eşyalar ve buluntu duyuruları.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Ilanlar" asp-action="Yeni" asp-route-tur="@Model.SelectedTur" class="btn btn-dark btn-sm px-3 shadow-sm rounded-3">
                <i class="bi bi-plus-lg me-1"></i> Yeni İlan Ver
            </a>
        </div>
    </div>

    <!-- Filtreleme ve Arama Çubuğu -->
    <div class="card border rounded-4 shadow-sm bg-white p-3 mb-4">
        <form method="get" asp-controller="Ilanlar" asp-action="Index" class="row g-2 align-items-center">
            <!-- Tür Filtresi -->
            <div class="col-md-3">
                <select name="tur" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedTur))">Tüm Türler</option>
                    <option value="Sosyal" selected="@(Model.SelectedTur == "Sosyal")">Sosyal Radar</option>
                    <option value="Kayip" selected="@(Model.SelectedTur == "Kayip")">Kayıp Eşya</option>
                    <option value="Buluntu" selected="@(Model.SelectedTur == "Buluntu")">Buluntu Eşya</option>
                </select>
            </div>

            <!-- Kategori Filtresi -->
            <div class="col-md-3">
                <select name="kategoriId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(!Model.SelectedKategoriId.HasValue)">Tüm Kategoriler</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.SelectedKategoriId == cat.Id)">@cat.Tur &bull; @cat.Ad</option>
                    }
                </select>
            </div>

            <!-- Metin Arama -->
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@Model.SearchQuery" class="form-control border-start-0" placeholder="Başlık, açıklama veya konumda ara..." />
                </div>
            </div>

            <!-- Filtrele & Temizle Butonları -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filtrele</button>
                @if (!string.IsNullOrEmpty(Model.SelectedTur) || Model.SelectedKategoriId.HasValue || !string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Filtreleri Temizle">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- İlan Kartları Listesi -->
    @if (!Model.PagedListings.Items.Any())
    {
        <div class="card border rounded-4 p-5 text-center bg-white shadow-sm my-4">
            <div class="text-muted mb-3"><i class="bi bi-inbox fs-1"></i></div>
            <h5 class="fw-bold text-dark">Henüz İlan Bulunmuyor</h5>
            <p class="text-muted small mb-3">Seçtiğiniz kriterlere uygun aktif ilan bulunamadı veya ilk ilanı henüz kimse açmadı.</p>
            <div>
                <a asp-controller="Ilanlar" asp-action="Yeni" asp-route-tur="@Model.SelectedTur" class="btn btn-dark btn-sm px-4">
                    <i class="bi bi-plus-circle me-1"></i> İlk İlanı Sen Ver
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var item in Model.PagedListings.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border rounded-4 p-4 shadow-sm bg-white h-100 d-flex flex-column hover-shadow transition">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge @(item.Tur switch {
                                "Sosyal" => "bg-primary-subtle text-primary border border-primary-subtle",
                                "Kayip" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "Buluntu" => "bg-success-subtle text-success border border-success-subtle",
                                _ => "bg-light text-dark border"
                            }) px-2 py-1 rounded-pill small">
                                @(item.Tur switch {
                                    "Sosyal" => "Sosyal Radar",
                                    "Kayip" => "Kayıp Eşya",
                                    "Buluntu" => "Buluntu Eşya",
                                    _ => item.Tur
                                })
                            </span>
                            <span class="text-muted small">@item.OlusturulmaTarihi.ToString("dd MMM yyyy")</span>
                        </div>

                        <h5 class="fw-bold text-dark mb-1 text-truncate">@item.Baslik</h5>
                        <p class="text-muted small mb-2 text-truncate-2" style="min-height: 2.4rem;">@item.Aciklama</p>

                        <div class="small text-muted mb-3">
                            <div><i class="bi bi-geo-alt me-1 text-danger"></i> <span class="fw-medium">@item.Yer</span></div>
                            @if (item.Tur == "Sosyal" && item.BulusmaTarihi.HasValue)
                            {
                                <div><i class="bi bi-clock me-1 text-primary"></i> <span>Buluşma: @item.BulusmaTarihi.Value.ToString("dd.MM.yyyy HH:mm")</span></div>
                            }
                            <div><i class="bi bi-tag me-1 text-secondary"></i> <span>@item.KategoriAd</span></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <span class="text-muted small">
                                @if (item.Tur == "Sosyal")
                                {
                                    <i class="bi bi-people me-1"></i> @item.KatilimciSayisi @("Katılımcı")
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">@item.Durum</span>
                                }
                            </span>
                            <a asp-controller="Ilanlar" asp-action="Detay" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark px-3 rounded-pill">
                                İncele <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sayfalama (Pagination) -->
        @if (Model.PagedListings.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-4">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PagedListings.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-tur="@Model.SelectedTur" asp-route-kategoriId="@Model.SelectedKategoriId" asp-route-q="@Model.SearchQuery" asp-route-sayfa="@(Model.PagedListings.Page - 1)">&laquo;</a>
                        </li>
                        @for (int p = 1; p <= Model.PagedListings.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PagedListings.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-tur="@Model.SelectedTur" asp-route-kategoriId="@Model.SelectedKategoriId" asp-route-q="@Model.SearchQuery" asp-route-sayfa="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PagedListings.Page >= Model.PagedListings.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-tur="@Model.SelectedTur" asp-route-kategoriId="@Model.SelectedKategoriId" asp-route-q="@Model.SearchQuery" asp-route-sayfa="@(Model.PagedListings.Page + 1)">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

