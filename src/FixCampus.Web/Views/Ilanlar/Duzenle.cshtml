@model FixCampus.Web.Models.ListingEditViewModel
@{
    ViewData["Title"] = "İlanı Düzenle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3">
                <a asp-action="Detay" asp-route-id="@Model.Id" class="text-decoration-none text-muted small fw-medium">
                    <i class="bi bi-arrow-left me-1"></i> İlan Detayına Dön
                </a>
            </div>

            <div class="card border rounded-4 shadow-sm overflow-hidden">
                <div class="card-header bg-light border-bottom p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h4 fw-bold mb-1">İlanı Düzenle</h1>
                            <p class="text-muted small mb-0">İlan bilgilerini güncelleyebilirsiniz.</p>
                        </div>
                        <span class="badge bg-dark px-3 py-2">
                            @(Model.Tur == "Sosyal" ? "Sosyal Buluşma" : Model.Tur == "Kayip" ? "Kayıp Eşya" : "Buluntu Eşya")
                        </span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Tur" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-12">
                                <label asp-for="KategoriId" class="form-label fw-semibold small">Kategori <span class="text-danger">*</span></label>
                                <select asp-for="KategoriId" class="form-select">
                                    @foreach (var cat in Model.Categories.Where(c => c.Tur == Model.Tur))
                                    {
                                        <option value="@cat.Id" selected="@(Model.KategoriId == cat.Id)">@cat.Ad</option>
                                    }
                                </select>
                                <span asp-validation-for="KategoriId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Baslik" class="form-label fw-semibold small">İlan Başlığı <span class="text-danger">*</span></label>
                            <input asp-for="Baslik" class="form-control" maxlength="150" />
                            <span asp-validation-for="Baslik" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-@(Model.Tur == "Sosyal" ? "6" : "12")">
                                <label asp-for="Yer" class="form-label fw-semibold small">Kampüs İçi Konum / Yer <span class="text-danger">*</span></label>
                                <input asp-for="Yer" class="form-control" maxlength="200" />
                                <span asp-validation-for="Yer" class="text-danger small"></span>
                            </div>

                            @if (Model.Tur == "Sosyal")
                            {
                                <div class="col-md-6">
                                    <label asp-for="BulusmaZamani" class="form-label fw-semibold small">Buluşma Tarihi & Saati <span class="text-danger">*</span></label>
                                    <input asp-for="BulusmaZamani" type="datetime-local" class="form-control" value="@(Model.BulusmaZamani?.ToString("yyyy-MM-ddTHH:mm"))" />
                                    <div class="form-text small">Sosyal buluşma tarihi gelecek bir zaman olmalıdır.</div>
                                    <span asp-validation-for="BulusmaZamani" class="text-danger small"></span>
                                </div>
                            }
                        </div>

                        <div class="mb-4">
                            <label asp-for="Aciklama" class="form-label fw-semibold small">Detaylı Açıklama <span class="text-danger">*</span></label>
                            <textarea asp-for="Aciklama" class="form-control" rows="5" maxlength="3000"></textarea>
                            <span asp-validation-for="Aciklama" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Detay" asp-route-id="@Model.Id" class="btn btn-light border px-4">Vazgeç</a>
                            <button type="submit" class="btn btn-dark px-4">
                                <i class="bi bi-check-lg me-1"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
