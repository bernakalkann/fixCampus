@model FixCampus.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">

            <div class="card border rounded-4 shadow-sm bg-white overflow-hidden">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border p-3 mb-3" style="width: 58px; height: 58px;">
                            <i class="bi bi-key-fill text-dark fs-3"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Şifremi Unuttum</h3>
                        <p class="text-muted small mb-0">Kayıtlı üniversite e-posta adresinizi girin, sıfırlama bağlantısı gönderelim.</p>
                    </div>

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small py-2 px-3 mb-3" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold small text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="ogrenci@ankara.edu.tr" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-2 rounded-3 fw-semibold mb-3">
                            Sıfırlama Bağlantısı Gönder
                        </button>

                        <div class="text-center">
                            <a asp-action="Login" class="text-muted small text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i> Giriş ekranına geri dön
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
