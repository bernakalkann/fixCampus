@model FixCampus.Web.Models.ListingFormViewModel
@{
    ViewData["Title"] = "Yeni İlan Oluştur";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none text-muted small fw-medium">
                    <i class="bi bi-arrow-left me-1"></i> İlanlara Dön
                </a>
            </div>

            <div class="card border rounded-4 shadow-sm overflow-hidden">
                <div class="card-header bg-light border-bottom p-4">
                    <h1 class="h4 fw-bold mb-1">Yeni Kampüs İlanı Oluştur</h1>
                    <p class="text-muted small mb-0">Sosyal buluşma organize edin veya kayıp/buluntu eşya duyurusu paylaşın.</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Yeni" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

                        <!-- İlan Türü Seçimi -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-uppercase text-muted">1. İlan Türünü Seçin</label>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check listing-type-radio" name="Tur" id="turSosyal" value="Sosyal" @(Model.Tur == "Sosyal" ? "checked" : "")>
                                    <label class="btn btn-outline-dark w-100 py-3 rounded-3 text-start px-3" for="turSosyal">
                                        <div class="fw-bold"><i class="bi bi-people-fill me-1"></i> Sosyal Radar</div>
                                        <div class="small opacity-75">Etkinlik, çalışma, spor</div>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check listing-type-radio" name="Tur" id="turKayip" value="Kayip" @(Model.Tur == "Kayip" ? "checked" : "")>
                                    <label class="btn btn-outline-danger w-100 py-3 rounded-3 text-start px-3" for="turKayip">
                                        <div class="fw-bold"><i class="bi bi-exclamation-circle-fill me-1"></i> Kayıp Eşya</div>
                                        <div class="small opacity-75">Kaybettiğiniz eşyalar</div>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check listing-type-radio" name="Tur" id="turBuluntu" value="Buluntu" @(Model.Tur == "Buluntu" ? "checked" : "")>
                                    <label class="btn btn-outline-success w-100 py-3 rounded-3 text-start px-3" for="turBuluntu">
                                        <div class="fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Buluntu Eşya</div>
                                        <div class="small opacity-75">Bulduğunuz eşyalar</div>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Tur" class="text-danger small"></span>
                        </div>

                        <!-- Kategori ve Başlık -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-5">
                                <label asp-for="KategoriId" class="form-label fw-semibold small">Kategori <span class="text-danger">*</span></label>
                                <select asp-for="KategoriId" id="kategoriSelect" class="form-select">
                                    @foreach (var cat in Model.Categories)
                                    {
                                        if (cat.Tur == Model.Tur)
                                        {
                                            <option value="@cat.Id" data-tur="@cat.Tur" selected="@(Model.KategoriId == cat.Id)">@cat.Ad</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="KategoriId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-7">
                                <label asp-for="Baslik" class="form-label fw-semibold small">İlan Başlığı <span class="text-danger">*</span></label>
                                <input asp-for="Baslik" class="form-control" placeholder="Örn: Merkez Kütüphane Algoritma Çalışma Grubu" maxlength="150" />
                                <span asp-validation-for="Baslik" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Konum ve Buluşma Zamanı -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Yer" class="form-label fw-semibold small">Kampüs İçi Konum / Yer <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Yer" class="form-control" placeholder="Örn: Mühendislik Fakültesi D-Blok Kantini" maxlength="200" />
                                </div>
                                <span asp-validation-for="Yer" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6" id="bulusmaTarihiContainer" style="@(Model.Tur == "Sosyal" ? "" : "display:none;")">
                                <label asp-for="BulusmaZamani" class="form-label fw-semibold small">Buluşma Tarihi & Saati <span class="text-danger">*</span></label>
                                <input asp-for="BulusmaZamani" type="datetime-local" id="bulusmaZamaniInput" class="form-control" value="@(Model.BulusmaZamani?.ToString("yyyy-MM-ddTHH:mm"))" />
                                <div class="form-text small">Sosyal buluşmalar için gelecek bir tarih/saat seçilmelidir.</div>
                                <span asp-validation-for="BulusmaZamani" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Açıklama -->
                        <div class="mb-4">
                            <label asp-for="Aciklama" class="form-label fw-semibold small">Detaylı Açıklama <span class="text-danger">*</span></label>
                            <textarea asp-for="Aciklama" class="form-control" rows="4" placeholder="Etkinlik detaylarını veya eşyanın ayırt edici özelliklerini, iletişim tercihlerinizi yazın..." maxlength="3000"></textarea>
                            <span asp-validation-for="Aciklama" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4">İptal</a>
                            <button type="submit" class="btn btn-dark px-4">
                                <i class="bi bi-check2-circle me-1"></i> İlanı Yayınla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const radios = document.querySelectorAll('.listing-type-radio');
            const dateContainer = document.getElementById('bulusmaTarihiContainer');
            const dateInput = document.getElementById('bulusmaZamaniInput');
            const catSelect = document.getElementById('kategoriSelect');

            async function updateTypeUI(selectedType) {
                if (selectedType === 'Sosyal') {
                    dateContainer.style.display = '';
                } else {
                    dateContainer.style.display = 'none';
                    if (dateInput) dateInput.value = '';
                }

                try {
                    const res = await fetch(`/Ilanlar/Kategoriler?tur=${encodeURIComponent(selectedType)}`);
                    if (res.ok) {
                        const categories = await res.json();
                        catSelect.innerHTML = '';
                        categories.forEach((c, idx) => {
                            const opt = document.createElement('option');
                            opt.value = c.id;
                            opt.textContent = c.ad;
                            if (idx === 0) opt.selected = true;
                            catSelect.appendChild(opt);
                        });
                    }
                } catch (e) {
                    console.error('Kategori yüklenemedi:', e);
                }
            }

            radios.forEach(r => {
                r.addEventListener('change', function () {
                    if (this.checked) updateTypeUI(this.value);
                });
            });
        });
    </script>
}
