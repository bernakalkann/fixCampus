@model FixCampus.Web.Models.ListingEditViewModel
@{
    ViewData["Title"] = "İlanı Düzenle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3">
                <a asp-action="Detay" asp-route-id="@Model.Id" class="text-decoration-none text-muted small fw-medium">
                    <i class="bi bi-arrow-left me-1"></i> İlan Detayına Dön
                </a>
            </div>

            <div class="card border rounded-4 shadow-sm overflow-hidden">
                <div class="card-header bg-light border-bottom p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h4 fw-bold mb-1">İlanı Düzenle</h1>
                            <p class="text-muted small mb-0">İlan bilgilerini güncelleyebilirsiniz.</p>
                        </div>
                        <span class="badge bg-dark px-3 py-2">
                            @(Model.Tur == "Sosyal" ? "Sosyal Buluşma" : Model.Tur == "Kayip" ? "Kayıp Eşya" : "Buluntu Eşya")
                        </span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Tur" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-12">
                                <label asp-for="KategoriId" class="form-label fw-semibold small">Kategori <span class="text-danger">*</span></label>
                                <select asp-for="KategoriId" class="form-select">
                                    @foreach (var cat in Model.Categories.Where(c => c.Tur == Model.Tur))
                                    {
                                        <option value="@cat.Id" selected="@(Model.KategoriId == cat.Id)">@cat.Ad</option>
                                    }
                                </select>
                                <span asp-validation-for="KategoriId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Baslik" class="form-label fw-semibold small">İlan Başlığı <span class="text-danger">*</span></label>
                            <input asp-for="Baslik" class="form-control" maxlength="150" />
                            <span asp-validation-for="Baslik" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-12">
                                <label asp-for="Yer" class="form-label fw-semibold small">Kampüs İçi Konum / Yer <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Yer" id="yerInput" class="form-control" maxlength="200" />
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
                                    <span class="text-muted small me-1">Hızlı Konum:</span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill small quick-loc-btn" data-loc="Merkez Kütüphane 2. Kat Çalışma Salonu">Kütüphane 2. Kat</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill small quick-loc-btn" data-loc="Mühendislik Fakültesi D-Blok Kantini">Mühendislik Kantini</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill small quick-loc-btn" data-loc="Kampüs Spor Tesisleri Halı Saha">Spor Tesisleri</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill small quick-loc-btn" data-loc="Gölbaşı Öğrenci Kafeteryası">Öğrenci Kafeteryası</button>
                                </div>
                                <span asp-validation-for="Yer" class="text-danger small"></span>
                            </div>

                            @if (Model.Tur == "Sosyal")
                            {
                                <div class="col-md-12">
                                    <div class="p-3 rounded-3 bg-light border">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label asp-for="BulusmaTarihiGun" class="form-label fw-semibold small">
                                                    <i class="bi bi-calendar-event me-1 text-primary"></i>Buluşma Tarihi <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="BulusmaTarihiGun" type="date" id="bulusmaTarihInput" class="form-control" value="@((Model.BulusmaTarihiGun ?? Model.BulusmaZamani?.Date)?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="BulusmaSaati" class="form-label fw-semibold small">
                                                    <i class="bi bi-clock me-1 text-primary"></i>Buluşma Saati <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="BulusmaSaati" type="time" id="bulusmaSaatInput" class="form-control" value="@((Model.BulusmaSaati ?? Model.BulusmaZamani?.TimeOfDay)?.ToString(@"hh\:mm"))" />
                                            </div>
                                        </div>
                                        <input asp-for="BulusmaZamani" type="hidden" id="bulusmaZamaniInput" value="@(Model.BulusmaZamani?.ToString("yyyy-MM-ddTHH:mm"))" />
                                        <div class="form-text small mt-2">Sosyal buluşma tarihi gelecek bir zaman olmalıdır.</div>
                                        <span asp-validation-for="BulusmaZamani" class="text-danger small d-block"></span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mb-4">
                            <label asp-for="Aciklama" class="form-label fw-semibold small">Detaylı Açıklama <span class="text-danger">*</span></label>
                            <textarea asp-for="Aciklama" class="form-control" rows="5" maxlength="3000"></textarea>
                            <span asp-validation-for="Aciklama" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Detay" asp-route-id="@Model.Id" class="btn btn-light border px-4">Vazgeç</a>
                            <button type="submit" class="btn btn-dark px-4">
                                <i class="bi bi-check-lg me-1"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_MeetingFormScriptsPartial" />
}
