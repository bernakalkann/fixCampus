@{
    ViewData["Title"] = "Kayıp & Buluntu";
}

<div class="container py-4">
    <!-- Sayfa Açıklaması ve Kapsam Bilgisi -->
    <div class="p-4 mb-4 rounded-4 bg-white border shadow-sm">
        <span class="badge bg-light text-dark border mb-2">Kayıp & Buluntu Modülü</span>
        <h2 class="fw-bold text-dark mb-2">Kayıp ve Buluntu Eşya Ekranı</h2>
        <p class="text-secondary mb-2">
            <strong>Modülün Amacı:</strong> Kampüs içinde kaybedilen ya da sahipsiz olarak bulunan eşyaların duyurulması, sahibine güvenle ulaştırılması ve sürecin takip edilmesidir.
        </p>
        <p class="text-muted small mb-0">
            <strong>Planlanan İşlevler:</strong> Kullanıcılar <em>"Kaybettim"</em> veya <em>"Buldum"</em> etiketiyle ilan verebilecek; isteğe bağlı tek fotoğraf yükleyebilecektir. Eşyası teslim edilenler ilanı <em>"Çözüldü"</em> olarak güncelleyebilecektir.
        </p>
    </div>

    <!-- Etiket ve Arama İskeleti -->
    <div class="card border rounded-4 p-3 mb-4 bg-white shadow-sm">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-dark active btn-sm">Tüm İlanlar</button>
                <button type="button" class="btn btn-outline-dark btn-sm">Kaybettim Etiketliler</button>
                <button type="button" class="btn btn-outline-dark btn-sm">Buldum Etiketliler</button>
                <button type="button" class="btn btn-outline-dark btn-sm">Çözülenler</button>
            </div>
            <div style="min-width: 250px;">
                <input type="text" class="form-control form-control-sm" placeholder="Eşya adı veya bulunduğu yer..." disabled />
            </div>
        </div>
    </div>

    <!-- Yeni İlan Açma Form İskeleti -->
    <div class="card border border-dashed rounded-4 p-5 d-flex flex-column justify-content-center align-items-center text-center bg-light">
        <h5 class="fw-bold text-dark mb-2">Kayıp / Buluntu İlan Açma Formu</h5>
        <p class="text-muted small mb-3" style="max-width: 480px;">
            Öğrenciler burada eşya başlığı, detaylı açıklama, "Kaybettim/Buldum" etiketi, kampüs konumu ve isteğe bağlı tek fotoğraf ekleyerek ilan paylaşabilecektir.
        </p>
        <button class="btn btn-outline-dark btn-sm px-4">
            Yeni İlan Formu Alanı
        </button>
    </div>
</div>
