@{
    ViewData["Title"] = "Sosyal Radar - Buluşmalar";
}

<div class="container py-4">
    <!-- Sayfa Açıklaması ve Kapsam Bilgisi -->
    <div class="p-4 mb-4 rounded-4 bg-white border shadow-sm">
        <span class="badge bg-light text-dark border mb-2">Sosyal Radar Modülü</span>
        <h2 class="fw-bold text-dark mb-2">Sosyal Radar Buluşma Ekranı</h2>
        <p class="text-secondary mb-2">
            <strong>Modülün Amacı:</strong> Üniversite öğrencilerinin ders aralarında veya boş vakitlerinde birlikte etkinlik düzenleyebileceği, ders çalışabileceği veya kahve içebileceği buluşma ilanlarını paylaşmasıdır.
        </p>
        <p class="text-muted small mb-0">
            <strong>Planlanan İşlevler:</strong> Buluşma yeri, tarih ve saat bilgisiyle ilan açılabilecek; diğer öğrenciler <em>"Geliyorum"</em> butonuyla katılabilecek veya katılımını geri alabilecektir. Süresi geçen buluşmalar aktif akıştan otomatik gizlenecektir.
        </p>
    </div>

    <!-- Filtreleme Bölümü İskeleti -->
    <div class="card border rounded-4 p-3 mb-4 bg-white shadow-sm">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" class="form-control" placeholder="Buluşma başlığı veya lokasyon ara..." disabled />
            </div>
            <div class="col-md-3">
                <select class="form-select" disabled>
                    <option>Zaman Filtresi (Bugün, Yarın, Hafta Sonu)</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" disabled>
                    <option>Konum (Kütüphane, Kafe, vb.)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-dark w-100 disabled">Filtrele</button>
            </div>
        </div>
    </div>

    <!-- Yeni Buluşma İlanı Açma Form İskeleti -->
    <div class="card border border-dashed rounded-4 p-5 d-flex flex-column justify-content-center align-items-center text-center bg-light">
        <h5 class="fw-bold text-dark mb-2">Yeni Buluşma İlanı Açma Formu</h5>
        <p class="text-muted small mb-3" style="max-width: 480px;">
            Öğrenciler burada buluşma başlığı, açıklama, kampüs içi konum ve buluşma zamanı (tarih/saat) girerek radar ilanı yayınlayabilecektir.
        </p>
        <button class="btn btn-outline-dark btn-sm px-4">
            Yeni Buluşma Formu Alanı
        </button>
    </div>
</div>
