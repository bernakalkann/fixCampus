@model FixCampus.Web.Contracts.ListingDetailResponse

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Geri Dönüş Linki -->
            <div class="mb-3">
                <a asp-action="Index" asp-route-tur="@Model.Tur" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> @(Model.Tur switch {
                        "Sosyal" => "Sosyal Radar İlanlarına Dön",
                        "Kayip" => "Kayıp Eşya İlanlarına Dön",
                        "Buluntu" => "Buluntu Eşya İlanlarına Dön",
                        _ => "Tüm İlanlara Dön"
                    })
                </a>
            </div>

            <!-- Ana Kart -->
            <div class="card border rounded-4 shadow-sm bg-white p-4 p-md-5 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(Model.Tur switch {
                            "Sosyal" => "bg-primary-subtle text-primary border border-primary-subtle",
                            "Kayip" => "bg-danger-subtle text-danger border border-danger-subtle",
                            "Buluntu" => "bg-success-subtle text-success border border-success-subtle",
                            _ => "bg-light text-dark border"
                        }) px-3 py-2 rounded-pill fw-semibold">
                            @(Model.Tur switch {
                                "Sosyal" => "Sosyal Radar Buluşması",
                                "Kayip" => "Kayıp Eşya",
                                "Buluntu" => "Buluntu Eşya",
                                _ => Model.Tur
                            })
                        </span>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            @Model.KategoriAd
                        </span>
                    </div>

                    <span class="badge @(Model.Durum switch {
                        "Aktif" => "bg-success text-white",
                        "Cozuldu" => "bg-secondary text-white",
                        _ => "bg-dark text-white"
                    }) px-3 py-2 rounded-pill">
                        @Model.Durum
                    </span>
                </div>

                <h1 class="display-6 fw-bold text-dark mb-3">@Model.Baslik</h1>

                <!-- Bilgi Şeridi -->
                <div class="row g-3 py-3 border-top border-bottom my-3 bg-light rounded-3 px-2">
                    <div class="col-sm-6 col-md-4">
                        <span class="text-muted small d-block">İlan Sahibi</span>
                        <div class="fw-semibold text-dark"><i class="bi bi-person-circle text-primary me-1"></i> @Model.SahipAd</div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <span class="text-muted small d-block">Konum / Yer</span>
                        <div class="fw-semibold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Yer</div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <span class="text-muted small d-block">Yayın Tarihi</span>
                        <div class="fw-semibold text-dark"><i class="bi bi-calendar-event me-1 text-secondary"></i> @Model.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                    @if (Model.Tur == "Sosyal" && Model.BulusmaTarihi.HasValue)
                    {
                        <div class="col-12 border-top pt-2 mt-2">
                            <span class="text-muted small d-block">Buluşma Zamanı</span>
                            <div class="fw-bold text-primary fs-5"><i class="bi bi-alarm-fill me-1"></i> @Model.BulusmaTarihi.Value.ToString("dd MMMM yyyy, dddd &bull; HH:mm")</div>
                        </div>
                    }
                </div>

                <!-- Detaylı Açıklama -->
                <div class="my-4">
                    <h5 class="fw-bold text-dark mb-3">İlan Açıklaması</h5>
                    <div class="p-3 bg-white rounded-3 border" style="line-height: 1.7; white-space: pre-wrap;">@Model.Aciklama</div>
                </div>

                <!-- Fotoğraf (varsa) -->
                @if (Model.Fotograflar != null && Model.Fotograflar.Any())
                {
                    <div class="my-4">
                        <h5 class="fw-bold text-dark mb-2">Fotoğraflar</h5>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var photo in Model.Fotograflar)
                            {
                                <img src="@photo" alt="İlan Fotoğrafı" class="img-fluid rounded-3 border" style="max-height: 250px; object-fit: cover;" />
                            }
                        </div>
                    </div>
                }

                <!-- Katılımcılar (Sosyal buluşmalar için) -->
                @if (Model.Tur == "Sosyal")
                {
                    <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                            <div>
                                <span class="fw-bold text-dark d-block">Buluşmaya Katılım</span>
                                <span class="text-muted small">Şu anda <strong>@Model.KatilimciSayisi</strong> kişi katılıyor.</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Yönetim / Sahiplik Aksiyonları -->
                @if (Model.CanManage)
                {
                    <div class="card bg-light border rounded-3 p-3 mt-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="text-dark d-block"><i class="bi bi-gear-fill me-1 text-secondary"></i> İlan Yönetimi</strong>
                                <span class="text-muted small">
                                    @(Model.IsOwner ? "Bu ilanın sahibisiniz." : "Yönetici yetkisi ile görüntülüyorsunuz.")
                                </span>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-dark px-3 rounded-pill">
                                    <i class="bi bi-pencil me-1"></i> Düzenle
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                    <i class="bi bi-trash me-1"></i> Sil
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Silme Onay Modalı -->
                    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 rounded-4 shadow">
                                <div class="modal-header border-bottom">
                                    <h5 class="modal-title fw-bold text-dark" id="deleteModalLabel">İlanı Silmek İstediğinize Emin Misiniz?</h5>
                                    <button type="button" class="btn-close" data-bs-toggle="modal" aria-label="Kapat"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="text-muted mb-0">
                                        <strong>"@Model.Baslik"</strong> başlıklı ilan kalıcı olarak sistemden silinecektir. Bu işlem geri alınamaz.
                                    </p>
                                </div>
                                <div class="modal-footer border-top">
                                    <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                                    <form asp-action="Sil" asp-route-id="@Model.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">
                                            <i class="bi bi-trash me-1"></i> Evet, İlanı Sil
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

