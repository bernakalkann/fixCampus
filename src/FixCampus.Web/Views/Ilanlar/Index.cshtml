@model FixCampus.Web.Models.ListingListViewModel
@{
    ViewData["Title"] = "Kampüs İlanları & Arama";
    var hasActiveFilters = !string.IsNullOrEmpty(Model.SelectedTur) || Model.SelectedKategoriId.HasValue || !string.IsNullOrEmpty(Model.SearchQuery);
}

<div class="container py-4">
    <!-- Sayfa Başlığı ve Yeni İlan Butonu -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-search text-primary me-2"></i>Kampüs İlanları & Arama
            </h2>
            <p class="text-muted small mb-0">Kampüsteki sosyal buluşmaları keşfedin, kayıp ve buluntu duyurularını kolayca arayın.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Ilanlar" asp-action="Yeni" asp-route-tur="@Model.SelectedTur" class="btn btn-dark btn-sm px-3 shadow-sm rounded-pill">
                <i class="bi bi-plus-lg me-1"></i> Yeni İlan Ver
            </a>
        </div>
    </div>

    <!-- Hızlı Tür Filtreleme Butonları (Pills) -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-action="Index" asp-route-q="@Model.SearchQuery" class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(Model.SelectedTur) ? "btn-dark" : "btn-outline-secondary")">
            Tüm İlanlar
        </a>
        <a asp-action="Index" asp-route-tur="Sosyal" asp-route-q="@Model.SearchQuery" class="btn btn-sm rounded-pill @(Model.SelectedTur == "Sosyal" ? "btn-primary" : "btn-outline-secondary")">
            <i class="bi bi-people-fill me-1"></i> Sosyal Radar
        </a>
        <a asp-action="Index" asp-route-tur="Kayip" asp-route-q="@Model.SearchQuery" class="btn btn-sm rounded-pill @(Model.SelectedTur == "Kayip" ? "btn-danger" : "btn-outline-secondary")">
            <i class="bi bi-exclamation-circle-fill me-1"></i> Kayıp Eşyalar
        </a>
        <a asp-action="Index" asp-route-tur="Buluntu" asp-route-q="@Model.SearchQuery" class="btn btn-sm rounded-pill @(Model.SelectedTur == "Buluntu" ? "btn-success" : "btn-outline-secondary")">
            <i class="bi bi-check-circle-fill me-1"></i> Buluntu Eşyalar
        </a>
    </div>

    <!-- Filtreleme ve Arama Çubuğu -->
    <div class="card border rounded-4 shadow-sm bg-white p-3 mb-4">
        <form method="get" asp-controller="Ilanlar" asp-action="Index" class="row g-2 align-items-center">
            <!-- Tür (Gizli veya Seçili Değer) -->
            <input type="hidden" name="tur" value="@Model.SelectedTur" />

            <!-- Kategori Filtresi -->
            <div class="col-md-4">
                <select name="kategoriId" class="form-select form-select-sm rounded-3">
                    <option value="" selected="@(!Model.SelectedKategoriId.HasValue)">Tüm Kategoriler</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (string.IsNullOrEmpty(Model.SelectedTur) || cat.Tur == Model.SelectedTur)
                        {
                            <option value="@cat.Id" selected="@(Model.SelectedKategoriId == cat.Id)">
                                @cat.Tur &bull; @cat.Ad
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- Metin Arama -->
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@Model.SearchQuery" class="form-control border-start-0 rounded-end-3" placeholder="Başlık, açıklama veya konumda ara (örn: kütüphane, cüzdan)..." />
                </div>
            </div>

            <!-- Filtrele Butonu -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-dark w-100 rounded-3">
                    <i class="bi bi-funnel me-1"></i> Filtrele
                </button>
            </div>
        </form>

        <!-- Aktif Filtre Rozetleri -->
        @if (hasActiveFilters)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 pt-3 mt-3 border-top">
                <span class="small text-muted fw-semibold me-1"><i class="bi bi-sliders me-1"></i>Aktif Filtreler:</span>

                @if (!string.IsNullOrEmpty(Model.SelectedTur))
                {
                    <span class="badge bg-light text-dark border rounded-pill py-2 px-3 small d-flex align-items-center gap-1">
                        Tür: @(Model.SelectedTur switch { "Sosyal" => "Sosyal Radar", "Kayip" => "Kayıp Eşya", "Buluntu" => "Buluntu Eşya", _ => Model.SelectedTur })
                        <a asp-action="Index" asp-route-kategoriId="@Model.SelectedKategoriId" asp-route-q="@Model.SearchQuery" class="text-muted text-decoration-none ms-1">&times;</a>
                    </span>
                }

                @if (Model.SelectedKategoriId.HasValue)
                {
                    var selectedCatName = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedKategoriId.Value)?.Ad ?? "Kategori";
                    <span class="badge bg-light text-dark border rounded-pill py-2 px-3 small d-flex align-items-center gap-1">
                        Kategori: @selectedCatName
                        <a asp-action="Index" asp-route-tur="@Model.SelectedTur" asp-route-q="@Model.SearchQuery" class="text-muted text-decoration-none ms-1">&times;</a>
                    </span>
                }

                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <span class="badge bg-light text-dark border rounded-pill py-2 px-3 small d-flex align-items-center gap-1">
                        Arama: "@Model.SearchQuery"
                        <a asp-action="Index" asp-route-tur="@Model.SelectedTur" asp-route-kategoriId="@Model.SelectedKategoriId" class="text-muted text-decoration-none ms-1">&times;</a>
                    </span>
                }

                <a asp-action="Index" class="btn btn-link btn-sm text-danger text-decoration-none p-0 ms-auto small">
                    <i class="bi bi-x-circle me-1"></i>Filtreleri Sıfırla
                </a>
            </div>
        }
    </div>

    <!-- Sonuç Başlığı / Meta -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="text-muted small">
            Toplam <strong class="text-dark">@Model.PagedListings.TotalCount</strong> ilan bulundu
            @if (Model.PagedListings.TotalPages > 1)
            {
                <span>(Sayfa @Model.PagedListings.Page / @Model.PagedListings.TotalPages)</span>
            }
        </div>
    </div>

    <!-- İlan Kartları Listesi -->
    @if (!Model.PagedListings.Items.Any())
    {
        <div class="card border rounded-4 p-5 text-center bg-white shadow-sm my-4">
            <div class="text-muted mb-3"><i class="bi bi-search fs-1"></i></div>
            <h5 class="fw-bold text-dark">Aramanızla Eşleşen İlan Bulunamadı</h5>
            <p class="text-muted small mb-3">Arama kriterlerinizi değiştirerek tekrar deneyebilir veya ilk ilanı siz oluşturabilirsiniz.</p>
            <div class="d-flex justify-content-center gap-2">
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-4 rounded-pill">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Filtreleri Temizle
                    </a>
                }
                <a asp-controller="Ilanlar" asp-action="Yeni" asp-route-tur="@Model.SelectedTur" class="btn btn-dark btn-sm px-4 rounded-pill">
                    <i class="bi bi-plus-circle me-1"></i> Yeni İlan Ver
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var item in Model.PagedListings.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border rounded-4 p-4 shadow-sm bg-white h-100 d-flex flex-column hover-shadow transition">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge @(item.Tur switch {
                                "Sosyal" => "bg-primary-subtle text-primary border border-primary-subtle",
                                "Kayip" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "Buluntu" => "bg-success-subtle text-success border border-success-subtle",
                                _ => "bg-light text-dark border"
                            }) px-2 py-1 rounded-pill small">
                                @(item.Tur switch {
                                    "Sosyal" => "Sosyal Radar",
                                    "Kayip" => "Kayıp Eşya",
                                    "Buluntu" => "Buluntu Eşya",
                                    _ => item.Tur
                                })
                            </span>
                            <span class="text-muted small" style="font-size: 0.8rem;">@item.OlusturulmaTarihi.ToString("dd MMM yyyy")</span>
                        </div>

                        <h5 class="fw-bold text-dark mb-1 text-truncate">@item.Baslik</h5>
                        <p class="text-muted small mb-3 text-truncate-2" style="min-height: 2.4rem;">@item.Aciklama</p>

                        <div class="small text-muted mb-3">
                            <div class="mb-1"><i class="bi bi-geo-alt me-1 text-danger"></i> <span class="fw-medium text-dark">@item.Yer</span></div>
                            @if (item.Tur == "Sosyal" && item.BulusmaTarihi.HasValue)
                            {
                                <div class="mb-1"><i class="bi bi-clock me-1 text-primary"></i> <span class="text-primary fw-medium">Buluşma: @item.BulusmaTarihi.Value.ToString("dd.MM.yyyy HH:mm")</span></div>
                            }
                            <div><i class="bi bi-tag me-1 text-secondary"></i> <span>@item.KategoriAd</span></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <span class="text-muted small">
                                @if (item.Tur == "Sosyal")
                                {
                                    <span class="badge bg-light text-primary border"><i class="bi bi-people me-1"></i>@item.KatilimciSayisi Katılımcı</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">@item.Durum</span>
                                }
                            </span>
                            <a asp-controller="Ilanlar" asp-action="Detay" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark px-3 rounded-pill">
                                İncele <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sayfalama (Pagination) -->
        @if (Model.PagedListings.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-4">
                <nav aria-label="İlan sayfaları">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PagedListings.Page <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-pill" asp-action="Index" asp-route-tur="@Model.SelectedTur" asp-route-kategoriId="@Model.SelectedKategoriId" asp-route-q="@Model.SearchQuery" asp-route-sayfa="@(Model.PagedListings.Page - 1)">&laquo; Önceki</a>
                        </li>
                        @for (int p = 1; p <= Model.PagedListings.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PagedListings.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-tur="@Model.SelectedTur" asp-route-kategoriId="@Model.SelectedKategoriId" asp-route-q="@Model.SearchQuery" asp-route-sayfa="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PagedListings.Page >= Model.PagedListings.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-end-pill" asp-action="Index" asp-route-tur="@Model.SelectedTur" asp-route-kategoriId="@Model.SelectedKategoriId" asp-route-q="@Model.SearchQuery" asp-route-sayfa="@(Model.PagedListings.Page + 1)">Sonraki &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>
