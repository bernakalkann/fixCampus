@model FixCampus.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-secondary border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-info-circle-fill fs-5 text-secondary"></i>
                    <div>@TempData["InfoMessage"]</div>
                </div>
            }

            <div class="card border rounded-4 shadow-sm bg-white overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border p-3 mb-3" style="width: 58px; height: 58px;">
                            <i id="authIcon" class="bi bi-person-fill text-dark fs-3"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1" id="authTitle">fixCampus Giriş</h3>
                        <p class="text-muted small mb-0" id="authSubtitle">Lütfen giriş yapmak istediğiniz hesap türünü seçiniz</p>
                    </div>

                    <!-- Giriş Türü Seçici (Öğrenci / Yönetici) -->
                    <div class="bg-light p-1 rounded-3 d-flex mb-4 border">
                        <button type="button" id="tabStudent" class="btn btn-sm flex-fill fw-semibold rounded-2 py-2 btn-dark" onclick="selectLoginType('student')">
                            <i class="bi bi-mortarboard me-1"></i> Öğrenci Girişi
                        </button>
                        <button type="button" id="tabAdmin" class="btn btn-sm flex-fill fw-semibold rounded-2 py-2 text-muted" onclick="selectLoginType('admin')">
                            <i class="bi bi-shield-lock me-1"></i> Yönetici (Admin)
                        </button>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post" novalidate id="loginForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" asp-for="UserType" id="userTypeInput" value="student" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small py-2 px-3 mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="EmailOrStudentNo" class="form-label fw-semibold small text-dark" id="emailOrStudentNoLabel">
                                E-posta veya Öğrenci No
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-person" id="inputIcon"></i>
                                </span>
                                <input asp-for="EmailOrStudentNo" class="form-control border-start-0 ps-0" id="emailOrStudentNoInput" placeholder="Örn: 22290455 veya e-posta" autofocus />
                            </div>
                            <span asp-validation-for="EmailOrStudentNo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Password" class="form-label fw-semibold small text-dark mb-0"></label>
                                <a asp-action="ForgotPassword" class="text-muted small text-decoration-none" id="forgotPasswordLink">Şifremi unuttum?</a>
                            </div>
                            <div class="input-group mt-1">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="Şifreniz" id="passwordInput" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
                            <label class="form-check-label text-muted small" for="rememberMeCheck">
                                Oturumumu açık tut
                            </label>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-2 rounded-3 fw-semibold" id="submitBtn">
                            Öğrenci Girişi Yap
                        </button>
                    </form>


                    <div class="text-center mt-4 pt-2" id="registerSection">
                        <span class="text-muted small">Henüz hesabınız yok mu?</span>
                        <a asp-action="Register" class="text-dark fw-semibold small ms-1 text-decoration-none border-bottom border-dark pb-1">
                            Hemen Kayıt Olun
                        </a>
                    </div>

                </div>
            </div>

            <!-- Bilgilendirme Kartı -->
            <div class="p-3 bg-light rounded-4 border mt-3 text-center text-muted small" id="adminInfoNotice" style="display: none;">
                <i class="bi bi-shield-exclamation text-warning me-1"></i>
                Yönetici Paneli yalnızca yetkilendirilmiş personel ve moderatörler içindir. İlan yönetimi ve kategori düzenleme yetkileri içerir.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function selectLoginType(type) {
            const tabStudent = document.getElementById('tabStudent');
            const tabAdmin = document.getElementById('tabAdmin');
            const userTypeInput = document.getElementById('userTypeInput');
            const label = document.getElementById('emailOrStudentNoLabel');
            const input = document.getElementById('emailOrStudentNoInput');
            const submitBtn = document.getElementById('submitBtn');
            const registerSection = document.getElementById('registerSection');
            const authTitle = document.getElementById('authTitle');
            const authSubtitle = document.getElementById('authSubtitle');
            const authIcon = document.getElementById('authIcon');
            const adminNotice = document.getElementById('adminInfoNotice');

            userTypeInput.value = type;

            if (type === 'admin') {
                tabStudent.classList.remove('btn-dark');
                tabStudent.classList.add('text-muted');
                tabAdmin.classList.add('btn-dark');
                tabAdmin.classList.remove('text-muted');

                label.innerText = 'Yönetici Kullanıcı Adı veya E-postası';
                input.placeholder = 'admin veya admin@ankara.edu.tr';
                submitBtn.innerText = 'Yönetici Paneline Giriş Yap';
                registerSection.style.display = 'none';
                authTitle.innerText = 'Yönetici Girişi';
                authSubtitle.innerText = 'fixCampus İlan ve Kategori Yönetim Paneli';
                authIcon.className = 'bi bi-shield-lock-fill text-dark fs-3';
                adminNotice.style.display = 'block';
            } else {
                tabAdmin.classList.remove('btn-dark');
                tabAdmin.classList.add('text-muted');
                tabStudent.classList.add('btn-dark');
                tabStudent.classList.remove('text-muted');

                label.innerText = 'E-posta veya Öğrenci No';
                input.placeholder = 'Örn: 22290455 veya e-posta';
                submitBtn.innerText = 'Öğrenci Girişi Yap';
                registerSection.style.display = 'block';
                authTitle.innerText = 'fixCampus Giriş';
                authSubtitle.innerText = 'Öğrenci hesabınızla oturum açın';
                authIcon.className = 'bi bi-person-fill text-dark fs-3';
                adminNotice.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const btnStudent = document.getElementById('tabStudent');
            const btnAdmin = document.getElementById('tabAdmin');

            if (btnStudent) {
                btnStudent.addEventListener('click', function () { selectLoginType('student'); });
            }
            if (btnAdmin) {
                btnAdmin.addEventListener('click', function () { selectLoginType('admin'); });
            }

            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('type') === 'admin' || urlParams.get('userType') === 'admin') {
                selectLoginType('admin');
            }
        });
    </script>
}
